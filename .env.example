# ==============================================================================
# ANICITY PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Nusxa oling: cp .env.example .env.local va o'z qiymatlaringizni kiriting
# ==============================================================================

# 1. SUPABASE SOZLAMALARI (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side boshqaruv uchun (Hech qachon brauzerga chiqarmang!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. VEB-SAYT ASOSIY MANZILI (Email tasdiqlash va qayta yo'naltirishlar uchun)
# Lokal ishlab chiqishda: http://localhost:3000
# Ishlab chiqarishda (Production): https://anicity-app.vercel.app yoki https://anicity.uz
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 3. VIDEO SHIFRLASH VA XAVFSIZLIK (HMAC Streaming Token)
# Video oqimi uchun ixtiyoriy 32+ belgili tasodifiy maxfiy kalit
VIDEO_SIGNING_KEY=anicity-super-secure-video-signing-key-replace-in-production

# 4. CLICK.UZ TO'LOV TIZIMI (Click Merchant Dashboard)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# 5. PAYME.UZ TO'LOV TIZIMI (Payme Business Dashboard)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# 6. GOOGLE OAUTH (Supabase Dashboard → Authentication → Providers → Google)
# Agar Google orqali kirishni faollashtirmoqchi bo'lsangiz:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
