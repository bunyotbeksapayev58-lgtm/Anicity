# ===== Supabase (Project Settings → API) =====
# Brauzerga chiqishi xavfsiz: RLS bilan himoyalangan
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sayt manzili (email tasdiqlash va parolni tiklash havolalari uchun)
# Lokal: http://localhost:3000   Production: https://sizning-domen.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FAQAT SERVER. Hech qachon NEXT_PUBLIC_ bilan boshlanmasin, GitHub ga yozilmasin.
SUPABASE_SERVICE_ROLE_KEY=

# Live QA tests are disabled unless ANICITY_ENABLE_LIVE_TESTS=YES is explicitly set.
# Use exact HTTPS hostnames for a dedicated test Supabase project and optional staging site.
# Do not include wildcards, production domains, or Vercel shared-hosting domains.
ANICITY_TEST_ENVIRONMENT=test
ANICITY_LIVE_TEST_ALLOWED_HOSTS=
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_QA_USER_EMAIL=
TEST_QA_USER_PASSWORD=
ANICITY_TEST_ACCOUNT_CONFIRMATION=
ANICITY_TEST_PROJECT_CONFIRMATION=
ANICITY_QA_TARGET_URL=

# Keyinroq (Google OAuth) — hozir kerak emas
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
