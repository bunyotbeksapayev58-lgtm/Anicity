# ===== Supabase (Project Settings → API) =====
# Brauzerga chiqishi xavfsiz: RLS bilan himoyalangan
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sayt manzili (email tasdiqlash va parolni tiklash havolalari uchun)
# Lokal: http://localhost:3000   Production: https://sizning-domen.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FAQAT SERVER. Hech qachon NEXT_PUBLIC_ bilan boshlanmasin, GitHub ga yozilmasin.
SUPABASE_SERVICE_ROLE_KEY=

# Keyinroq (Google OAuth) — hozir kerak emas
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
