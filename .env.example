# ==============================================================================
# ANICITY PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Nusxa oling: cp .env.example .env.local va o'z qiymatlaringizni kiriting
# ==============================================================================

# 1. SUPABASE SOZLAMALARI (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side boshqaruv uchun (Hech qachon brauzerga yoki git'ga chiqarmang!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. VEB-SAYT ASOSIY MANZILI (Email tasdiqlash, to'lov returnUrl va metadata uchun)
# Lokal ishlab chiqishda: http://localhost:3000
# Ishlab chiqarishda (Production): https://sizning-domeningiz.uz
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 3. VIDEO SHIFRLASH VA XAVFSIZLIK (HMAC Streaming Token)
# Video oqimi uchun 32+ belgili kuchli maxfiy kalit (Terminalda: openssl rand -hex 32)
# DIQQAT: Production'da bo'sh yoki default kalit qoldirish taqiqlanadi!
VIDEO_SIGNING_KEY=

# 4. CLICK.UZ TO'LOV TIZIMI (Click Merchant Dashboard)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# 5. PAYME.UZ TO'LOV TIZIMI (Payme Business Dashboard)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# 6. TO'LOV SANDBOX / TEST REJIMI
# Haqiqiy Click/Payme ulanishidan oldin to'lovlarni test qilish uchun:
ENABLE_PAYMENTS_SANDBOX=false
PAYMENTS_SANDBOX_SECRET=

# 7. VIDEO STREAMING — BUNNY.NET STREAM (ENG ARZON STREAMING YECHIMI: $0.01/GB)
# Qo'llanma: docs/VIDEO_STREAMING_SETUP.md fayliga qarang
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx.b-cdn.net
NEXT_PUBLIC_BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx.b-cdn.net

# 8. CLOUDFLARE R2 STREAMING (BEPUL EGRESS TRAFIK)
CLOUDFLARE_R2_PUBLIC_URL=

# 9. GOOGLE OAUTH (Supabase Dashboard → Authentication → Providers → Google)
# Agar Google orqali kirishni faollashtirmoqchi bo'lsangiz:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 10. GOOGLE SEARCH CONSOLE & SEO VERIFIKATSIYA
# Google Search Console'da HTML meta tegdan olingan kod:
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Yandex Webmaster verifikatsiyasi (agar kerak bo'lsa):
NEXT_PUBLIC_YANDEX_VERIFICATION=

# 11. GOOGLE ANALYTICS 4 (GA4) & GOOGLE TAG MANAGER (GTM)
# Google Analytics 4 Measurement ID (masalan: G-XXXXXXXXXX):
NEXT_PUBLIC_GA_ID=
# Google Tag Manager Container ID (masalan: GTM-XXXXXXX):
NEXT_PUBLIC_GTM_ID=

# 12. BREND VA IJTIMOIY TARMOQ SOZLAMALARI (Ixtiyoriy)
NEXT_PUBLIC_SITE_NAME=AniCity
NEXT_PUBLIC_TELEGRAM_ADMIN=anicity_admin
NEXT_PUBLIC_TELEGRAM_CHANNEL=anicity_uz
NEXT_PUBLIC_INSTAGRAM=anicity_uz
NEXT_PUBLIC_YOUTUBE=anicity_uz
